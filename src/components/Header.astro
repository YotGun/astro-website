---
import { APP_URL } from '../consts';

const navItems = [
	{ label: 'About', href: '#about' },
	{ label: 'Project 1', href: '#project1' },
	{ label: 'Project 2', href: '#project2' },
];
---

<header class="site-header">
	<div class="site-header__inner">
		<a href="#" class="site-header__logo">regan.ng</a>

		<nav class="site-header__nav" aria-label="Main">
			<ul class="site-header__nav-list">
				{
					navItems.map((item) => (
						<li>
							<a href={item.href} class="site-header__nav-link">{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a href={APP_URL} class="site-header__login-btn" target="_blank" rel="noopener noreferrer">
			App Login
		</a>
	</div>
</header>
