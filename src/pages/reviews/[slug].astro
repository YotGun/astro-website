---
import type { InferGetStaticPropsType } from 'astro';
import ReviewMedia from '../../components/ReviewMedia.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getReviews } from '../../lib/reviews';

// One page per folder in src/reviews/ (the folder name is the URL).
export function getStaticPaths() {
	return getReviews().map((review) => ({
		params: { slug: review.slug },
		props: { review },
	}));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { review } = Astro.props;
const { Content } = review;
---

<PageLayout title={`${review.title} | Reviews | ${SITE_TITLE}`} description={review.description}>
	<a class="review__back" href="/reviews/" data-reveal>
		<span aria-hidden="true">←</span> All reviews
	</a>

	<div class="review__layout">
		<aside class:list={['review__aside', { 'review__aside--tall': review.pictures.length > 0 }]} data-reveal>
			<div class="review__cover fx-lift">
				<ReviewMedia media={review.thumbnail} width={1000} loading="eager" />
			</div>
			<p class="review__posted">
				<span class="review__posted-label">Posted</span>
				<time datetime={review.date}>{review.dateLabel}</time>
			</p>
			{
				review.pictures.length > 0 && (
					<div class="review__pictures">
						{review.pictures.map((picture) => (
							<div class="review__picture fx-lift">
								<ReviewMedia media={picture} width={1000} loading="lazy" />
							</div>
						))}
					</div>
				)
			}
		</aside>

		<article class="review__article" data-reveal="fade">
			<div class="prose">
				{!review.hasTitleHeading && <h1>{review.title}</h1>}
				<Content />
			</div>
		</article>
	</div>
</PageLayout>

<style>
	/* ---------- Layout ---------- */

	.review__back {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 2rem;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		color: var(--text-muted);
		transition: color var(--dur-fast) ease;
	}

	.review__back span {
		transition: transform var(--dur-base) var(--ease-out);
	}

	.review__back:hover {
		color: var(--text);
	}

	.review__back:hover span {
		transform: translateX(-5px);
	}

	.review__layout {
		display: grid;
		grid-template-columns: minmax(15rem, 22rem) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}

	.review__aside {
		position: sticky;
		top: 6.5rem;
	}

	.review__article {
		min-width: 0;
		max-width: 46rem;
	}

	/* ---------- Thumbnail + date ---------- */

	.review__cover {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 1px solid var(--surface-border);
		border-radius: 16px;
		background: #140e18;
		box-shadow: 0 30px 60px -32px var(--glow);
	}

	.review__cover :global(:is(img, video)) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.review__posted {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1.1rem 0 0;
		font-family: 'JetBrains Mono Thin', monospace;
		font-size: 0.86rem;
		color: var(--text-muted);
	}

	.review__posted::before {
		content: '';
		flex: none;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 10px var(--accent-glow);
	}

	.review__posted-label {
		opacity: 0.7;
	}

	/* ---------- Extra pictures ---------- */

	/* A sticky column taller than the screen would hide its bottom, so let it scroll normally. */
	.review__aside--tall {
		position: static;
	}

	.review__pictures {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.review__picture {
		overflow: hidden;
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		background: #140e18;
	}

	.review__picture :global(:is(img, video)) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* ---------- Markdown ---------- */

	.prose :global(h1) {
		margin: 0 0 1.5rem;
		font-family: 'JetBrains Mono', monospace;
		font-size: clamp(1.9rem, 3.8vw, 3rem);
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: var(--text);
		overflow-wrap: anywhere;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin: 2.4rem 0 0.9rem;
		font-family: 'JetBrains Mono', monospace;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: var(--text);
	}

	.prose :global(h2) {
		font-size: clamp(1.25rem, 2vw, 1.6rem);
	}

	.prose :global(h3) {
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
	}

	.prose :global(h4) {
		font-size: 1rem;
	}

	.prose :global(p),
	.prose :global(li) {
		font-family: 'JetBrains Mono Thin', monospace;
		font-size: clamp(0.92rem, 1.1vw, 1.05rem);
		line-height: 1.8;
		color: #c9c9c9;
	}

	.prose :global(p) {
		margin: 0 0 1.1rem;
	}

	.prose :global(strong) {
		font-family: 'JetBrains Mono Bold', monospace;
		font-weight: 700;
		color: var(--text);
	}

	.prose :global(em) {
		color: var(--text);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.3rem;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.45rem;
		padding-left: 0.3rem;
	}

	.prose :global(li::marker) {
		color: var(--accent);
	}

	.prose :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: rgba(63, 209, 179, 0.4);
		text-underline-offset: 0.2em;
		transition:
			color var(--dur-fast) ease,
			text-decoration-color var(--dur-fast) ease;
	}

	.prose :global(a:hover) {
		color: var(--text);
		text-decoration-color: currentColor;
	}

	.prose :global(blockquote) {
		margin: 1.8rem 0;
		padding: 0.5rem 0 0.5rem 1.3rem;
		border-left: 2px solid var(--accent);
		background: linear-gradient(90deg, rgba(63, 209, 179, 0.09), transparent 70%);
	}

	.prose :global(blockquote p) {
		margin: 0;
		color: var(--text);
	}

	.prose :global(code) {
		padding: 0.15em 0.4em;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.08);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.88em;
		color: var(--text);
	}

	.prose :global(pre) {
		margin: 1.6rem 0;
		padding: 1rem 1.2rem;
		overflow-x: auto;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		font-size: 0.85rem;
		line-height: 1.6;
	}

	.prose :global(pre code) {
		padding: 0;
		background: none;
		font-size: inherit;
	}

	.prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.6rem 0;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
	}

	.prose :global(hr) {
		height: 1px;
		margin: 2.5rem 0;
		border: 0;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.25), transparent);
	}

	.prose :global(table) {
		width: 100%;
		margin: 1.6rem 0;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.6rem 0.8rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		font-family: 'JetBrains Mono Thin', monospace;
		text-align: left;
		color: #c9c9c9;
	}

	.prose :global(th) {
		font-family: 'JetBrains Mono', monospace;
		color: var(--text);
	}

	.prose > :global(:last-child) {
		margin-bottom: 0;
	}

	/* ---------- Small screens ---------- */

	@media (max-width: 860px) {
		.review__layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
		}

		.review__aside {
			position: static;
			max-width: 28rem;
		}
	}
</style>
