---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main id="main">
		<figure class="hero-media">
			<img src="/images/headerimg.JPG" alt="" width="960" height="720" />
		</figure>
		<div class="hero-copy">
			<h1>
				<span class="hero-name">Hey, I'm Regan Ng!</span>
				<span class="hero-lede">Here you'll find some of the things I've made, or at least tried making.</span>
				<span class="hero-lede">Site's still a work in progress, so please be nice :D</span>
			</h1>
			<div class="links">
				<a href="https://github.com/YotGun" target="_blank" class="github">
					<img src="/icons/github.svg" alt="GitHub" class="github-icon">
				</a>
				<a href="https://www.linkedin.com/in/reganvrn/" target="_blank" class="linkedin">
					<img src="/icons/linkedin.svg" alt="LinkedIn" class="linkedin-icon">
				</a>
				<a href="mailto:regan.ng@ualberta.ca" target="_blank" class="email" title="personal@regan.ng">
					<img src="/icons/email.svg" alt="Email" class="email-icon">
				</a>
			</div>
		</div>
	</main>
	<div class="curtain-sizer" aria-hidden="true"></div>
	<div id="page-content">
	<section id="about" class="content-section content-section--left">
		<div class="content-section__copy">
			<h2>About</h2>
			<p>I am currently a student at the University of Alberta, pursuing a Bachelor of Science in Computing Science with a minor in Mathematics.</p>
			<p>I came to Edmonton, Canada from Indonesia in 2023, and I've loved every moment of it.</p>
			<p>Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Vestibulum tortor quam, feugiat vitae, ultricies eget, tempor sit amet, ante.</p>
		</div>
		<figure class="content-section__media">
			<img src="/images/placeholder.svg" alt="" width="960" height="720" />
		</figure>
	</section>
	<section id="sample1" class="content-section content-section--right">
		<div class="content-section__copy">
			<h2>Sample1</h2>
			<p>Nam libero tempore, cum soluta nobis est eligendi optio cumque nihil impedit quo minus id quod maxime placeat facere possimus, omnis voluptas assumenda est, omnis dolor repellendus.</p>
			<p>Temporibus autem quibusdam et aut officiis debitis aut rerum necessitatibus saepe eveniet ut et voluptates repudiandae sint et molestiae non recusandae. Itaque earum rerum hic tenetur a sapiente delectus.</p>
			<p>At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate non provident.</p>
		</div>
		<figure class="content-section__media">
			<img src="/images/placeholder.svg" alt="" width="960" height="720" />
		</figure>
	</section>
	<section id="sample2" class="content-section content-section--left">
		<div class="content-section__copy">
			<h2>Sample2</h2>
			<p>Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.</p>
			<p>Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.</p>
			<p>Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed quia non numquam eius modi tempora incidunt ut labore et dolore magnam aliquam quaerat voluptatem.</p>
		</div>
		<figure class="content-section__media">
			<img src="/images/placeholder.svg" alt="" width="960" height="720" />
		</figure>
	</section>
	</div>
</Layout>

<style>
	main {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 5;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(1.1rem, 3.5vh, 2rem);
		box-sizing: border-box;
		container-type: inline-size;
		width: 100%;
		max-width: 100%;
		height: 100dvh;
		padding-top: 5.25rem;
		padding-bottom: 2.25rem;
		padding-inline: clamp(1.25rem, 8vw, 10rem);
		overflow-x: clip;
		overscroll-behavior-y: none;
		background: var(--bg);
		will-change: transform;
		text-align: center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
		width: min(100%, 42rem);
	}

	.hero-media {
		margin: 0;
		width: min(100%, 28rem);
		min-width: 0;
	}

	.hero-media img {
		display: block;
		width: 100%;
		height: auto;
		max-height: min(38vh, 22rem);
		aspect-ratio: 4 / 3;
		object-fit: cover;
		margin-inline: auto;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: #140e18;
	}

	.curtain-sizer {
		pointer-events: none;
	}

	html.is-curtain-active #page-content {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		overflow-anchor: none;
	}

	#page-content {
		position: relative;
		z-index: 1;
		will-change: transform;
		background:
			radial-gradient(ellipse 85% 42% at 88% 6%, rgba(65, 29, 79, 0.62) 0%, transparent 78%),
			radial-gradient(ellipse 70% 38% at 8% 34%, rgba(26, 107, 92, 0.38) 0%, transparent 75%),
			radial-gradient(ellipse 72% 40% at 92% 66%, rgba(140, 42, 58, 0.34) 0%, transparent 76%),
			radial-gradient(ellipse 80% 44% at 10% 96%, rgba(65, 29, 79, 0.48) 0%, transparent 78%),
			linear-gradient(180deg, #16101c 0%, #101614 38%, #161014 72%, #120e18 100%);
	}

	main h1 {
		font-family: 'JetBrains Mono', monospace;
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0;
		max-width: 100%;
		overflow-wrap: break-word;
	}

	.hero-name {
		display: block;
		font-size: clamp(1.55rem, min(3.6cqi + 0.4rem, 6vh), 3.15rem);
		line-height: 1.2;
		margin-bottom: 0.7em;
	}

	.hero-lede {
		display: block;
		font-family: 'JetBrains Mono Thin', monospace;
		font-size: clamp(0.92rem, min(1.55cqi + 0.3rem, 2.8vh), 1.3rem);
		line-height: 1.5;
		text-wrap: balance;
		color: var(--text);
	}

	.hero-lede + .hero-lede {
		margin-top: 0.3em;
	}

	.links {
		margin-top: 3rem;
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		filter: invert(1);
	}

	.links a {
		display: block;
		flex: 0 0 auto;
		width: 1.75rem;
		height: 1.75rem;
		overflow: hidden;
	}

	.links a.email {
		width: auto;
		overflow: visible;
	}

	.github:hover, .linkedin:hover {
		cursor: pointer;
		filter: brightness(0) saturate(100%) invert(43%) sepia(95%) saturate(2136%) hue-rotate(22deg) brightness(97%) contrast(99%);
		transition: filter 0.3s ease;
	}

	.github-icon, .linkedin-icon, .email-icon {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
		min-width: 0;
		min-height: 0;
		object-fit: contain;
	}
	
	.email {
		position: relative;
		display: flex;
		align-items: center;
	}

	.email-icon {
		width: 1.75rem;
		height: 1.75rem;
		transition: opacity 0.3s ease;
	}

	.email::after {
		content: "personal@regan.ng";
		position: absolute;
		left: 0;
		top: 50%;
		translate: 0 -50%;
		opacity: 0;
		font-family: 'JetBrains Mono Thin', monospace;
		font-style: italic;
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1;
		white-space: nowrap;
		filter: invert(1);
		color: var(--text);
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.email:hover .email-icon {
		opacity: 0;
	}

	.email:hover::after {
		opacity: 1;
	}

	.content-section {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(2rem, 6vw, 6rem);
		box-sizing: border-box;
		min-height: 100dvh;
		scroll-margin-top: 4rem;
		padding: 6rem clamp(1rem, 10vw, 10rem);
	}

	.content-section--right {
		flex-direction: row-reverse;
	}

	.content-section__copy {
		flex: 1 1 22rem;
		max-width: 36rem;
		min-width: 0;
	}

	.content-section__media {
		flex: 1 1 20rem;
		max-width: 42rem;
		margin: 0;
		min-width: 0;
	}

	.content-section__media img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: #140e18;
	}

	.content-section h2 {
		font-family: 'JetBrains Mono', monospace;
		font-size: clamp(1.5rem, 2.5vw, 2.25rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0 0 1.25rem;
	}

	.content-section p {
		font-family: 'JetBrains Mono Thin', monospace;
		font-size: clamp(0.9rem, 1.1vw, 1.05rem);
		line-height: 1.7;
		color: var(--text-muted);
		margin: 0 0 1rem;
	}

	.content-section p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 640px) {
		main {
			padding-inline: 1.25rem;
			gap: 1.25rem;
		}

		.hero-media {
			width: min(100%, 20rem);
		}

		.links {
			margin-top: 1.25rem;
		}
	}

	@media (max-height: 520px) {
		main {
			padding-top: 4.25rem;
			padding-bottom: 1rem;
			gap: 0.85rem;
			justify-content: center;
		}

		.hero-media img {
			max-height: min(32vh, 10.5rem);
		}

		.hero-name {
			margin-bottom: 0.45em;
		}

		.links {
			margin-top: 0.9rem;
		}
	}

	@media (orientation: portrait) {
		main {
			position: relative;
			height: auto;
			max-height: none;
			min-height: 0;
			z-index: auto;
			will-change: auto;
			transform: none !important;
			pointer-events: auto !important;
			padding-top: 6.5rem;
			padding-bottom: 3.5rem;
			gap: 1.75rem;
		}

		.hero-media {
			width: min(100%, 22rem);
		}

		.hero-media img {
			max-height: none;
		}

		.curtain-sizer {
			display: none;
		}

		#page-content {
			position: relative;
			will-change: auto;
			transform: none !important;
		}

		.content-section,
		.content-section--right {
			flex-direction: column;
			align-items: stretch;
			justify-content: center;
			min-height: auto;
			padding-block: 4.5rem;
		}

		.content-section__copy,
		.content-section__media {
			max-width: none;
		}
	}

	@media (max-width: 900px) and (orientation: landscape) {
		.content-section,
		.content-section--right {
			flex-direction: column;
			align-items: stretch;
			min-height: auto;
		}

		.content-section__copy,
		.content-section__media {
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		main {
			position: relative;
			height: auto;
			max-height: none;
			min-height: 0;
			z-index: auto;
			will-change: auto;
			transform: none !important;
			pointer-events: auto !important;
		}

		.curtain-sizer {
			display: none;
		}

		#page-content {
			position: relative;
			will-change: auto;
			transform: none !important;
		}
	}

</style>

<script>
	const curtain = document.getElementById('main');
	const content = document.getElementById('page-content');
	const sizer = document.querySelector('.curtain-sizer');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const isPortrait = window.matchMedia('(orientation: portrait)');

	let ticking = false;

	function curtainDisabled() {
		return reduceMotion.matches || isPortrait.matches;
	}

	function liftMax() {
		return window.innerHeight;
	}

	function resetCurtain() {
		document.documentElement.classList.remove('is-curtain-active');
		if (curtain) {
			curtain.style.transform = '';
			curtain.style.pointerEvents = '';
		}
		if (content) content.style.transform = '';
		if (sizer instanceof HTMLElement) sizer.style.height = '';
		ticking = false;
	}

	function syncSizer() {
		if (!(sizer instanceof HTMLElement) || !content || curtainDisabled()) return;
		sizer.style.height = `${liftMax() + content.scrollHeight}px`;
	}

	function updateCurtain() {
		if (!curtain || !content || curtainDisabled()) {
			resetCurtain();
			return;
		}

		document.documentElement.classList.add('is-curtain-active');
		syncSizer();

		const max = liftMax();
		const y = window.scrollY;
		const lift = Math.min(y, max);
		const shift = Math.max(0, y - max);

		curtain.style.transform = `translate3d(0, ${-lift}px, 0)`;
		content.style.transform = `translate3d(0, ${-shift}px, 0)`;
		curtain.style.pointerEvents = lift >= max ? 'none' : '';
		ticking = false;
	}

	function onScrollOrResize() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(updateCurtain);
	}

	function scrollToHash(hash, smooth) {
		const id = hash.replace('#', '');
		if (!id || id === 'main') {
			window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
			return;
		}

		const target = document.getElementById(id);
		if (!target) return;

		if (curtainDisabled()) {
			target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto' });
			return;
		}

		window.scrollTo({
			top: liftMax() + target.offsetTop,
			behavior: smooth ? 'smooth' : 'auto',
		});
	}

	window.addEventListener('scroll', onScrollOrResize, { passive: true });
	window.addEventListener('resize', onScrollOrResize);
	reduceMotion.addEventListener('change', updateCurtain);
	isPortrait.addEventListener('change', updateCurtain);

	if (content) {
		new ResizeObserver(onScrollOrResize).observe(content);
	}

	document.querySelectorAll('a[href^="#"]').forEach((link) => {
		const href = link.getAttribute('href');
		if (!href || href === '#') return;
		link.addEventListener('click', (event) => {
			event.preventDefault();
			scrollToHash(href, !reduceMotion.matches);
			history.pushState(null, '', href);
		});
	});

	updateCurtain();
	if (location.hash) scrollToHash(location.hash, false);
</script>
