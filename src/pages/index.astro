---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<h1>Regan Ng</h1>
	</main>
</Layout>

<style>
	main {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100dvh;
		padding: 1.5rem;
		overscroll-behavior-y: none;
		background: #0d1417;
		background: linear-gradient(135deg, rgba(13, 20, 23, 1) 0%, rgba(148, 0, 91, 1) 50%, rgba(150, 0, 0, 1) 100%);
}
	h1 {
		margin: 0;
		font-family: 'Arial Black';
		font-style: italic;
		font-size: clamp(15rem, 6vw, 25rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		color: var(--text);
	}
</style>
