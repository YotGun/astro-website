---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main id="main">
		<h1>BSc. Computing Science<br>
			Minor in Mathematics</h1>
		<a href="https://www.ualberta.ca/en/index.html" target="_blank" class="uni">
			<h2>University of Alberta | 2023 - 2027
			</h2>
		</a>
		<div class="links">
			<a href="https://github.com/YotGun" target="_blank" class="github">
				<img src="/icons/github.svg" alt="GitHub" class="github-icon">
			</a>
			<a href="https://www.linkedin.com/in/reganvrn/" target="_blank" class="linkedin">
				<img src="/icons/linkedin.svg" alt="LinkedIn" class="linkedin-icon">
			</a>
			<a href="mailto:regan.ng@ualberta.ca" target="_blank" class="email">
				<img src="/icons/email.svg" alt="Email" class="email-icon">
			</a>
		</div>
	</main>

	<section id="about" class="placeholder-section" aria-label="About">
		<h2 class="sr-only">About</h2>
	</section>
	<section id="sample1" class="placeholder-section" aria-label="Sample1">
		<h2 class="sr-only">Sample1</h2>
	</section>
	<section id="sample1" class="placeholder-section" aria-label="Sample2">
		<h2 class="sr-only">Sample2</h2>
	</section>
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
		justify-content: left;
		min-height: 100dvh;
		padding: 10vw;
		padding-top: 14vw;
		overscroll-behavior-y: none;
		background: var(--bg)
	}

	main h1 {
		font-family: 'JetBrains Mono', monospace;
		font-style: italic;
		font-size: 4vw;
		font-weight: 400;
		letter-spacing: -0.02em;
		color: var(--text);
		margin-bottom: 0;
	}

	.uni {
		font-family: 'JetBrains Mono Thin', monospace;
		font-style: italic;
		font-size: 2vw;
		font-weight: 400;
		color: var(--text-muted);
		transition: color 0.3s ease;
	}

	.uni:hover {
		cursor: pointer;
		color: var(--blue);
		transition: color 0.3s ease;
	}

	.links {
		margin-top: 10vh;
		display: flex;
		flex-direction: row;
		justify-content: left;
		gap: 2vw;
		height: 3vw;
		filter: invert(1);
	}

	.github:hover, .linkedin:hover {
		cursor: pointer;
		filter: brightness(0) saturate(100%) invert(43%) sepia(95%) saturate(2136%) hue-rotate(22deg) brightness(97%) contrast(99%);
		transition: filter 0.3s ease;
	}

	.github-icon, .linkedin-icon, .email-icon {
		width: 100%;
		height: 100%;
	}
	
	.email {
		position: relative;
		display: inline-flex;
		align-items: center;
	}

	.email-icon {
		transition: opacity 0.3s ease;
	}

	.email::after {
		content: "personal@regan.ng";
		position: absolute;
		opacity: 0;
		font-family: 'JetBrains Mono Thin', monospace;
		font-style: italic;
		font-size: 2vw;
		font-weight: 400;
		filter: invert(1);
		color: var(--text);
		
		transition: opacity 0.3s ease;
	}

	.email:hover .email-icon {
		opacity: 0;
	}

	.email:hover::after {
		opacity: 1;
	}

	.placeholder-section {
		min-height: 100dvh;
		scroll-margin-top: 4rem;
	}
</style>
